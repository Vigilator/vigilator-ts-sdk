{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!node_modules", "!dist", "!coverage", "!src/generated"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
